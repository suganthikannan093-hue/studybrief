# BharatCode model API (https://bharatcode.ai/build). Get a developer key at https://bharatcode.ai/account
# API access needs Lite, Pro or verified student access. Keep the key server-side only.
BHARATCODE_API_KEY=
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b

# Optional: force the offline demo (labelled "Offline demo") even if a key is set
# STUDYBRIEF_MODE=mock

# LOCAL TESTING ONLY - never used unless STUDYBRIEF_TEST_FALLBACK=openai is set.
# Hackathon rules require BharatCode for the AI calls; do not enable this for the demo.
# STUDYBRIEF_TEST_FALLBACK=openai
# OPENAI_API_KEY=
